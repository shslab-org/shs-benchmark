```python
def is_email(s: str) -> bool:
    parts = s.split("@")
    if len(parts) != 2:
        return False
    local, domain = parts
    if not local or not domain:
        return False
    # domain must look like host.name (a dot, not leading/trailing)
    if "." not in domain or domain.startswith(".") or domain.endswith("."):
        return False
    return True
```

